<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere (Android's default), but for this device itself: a small
     APK's game can be served from the computer through `adb reverse` while
     testing an export (com.psdk.remote). Nothing leaves the device there. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

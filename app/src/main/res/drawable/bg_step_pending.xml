<?xml version="1.0" encoding="utf-8"?>
<!-- Pending step: stroke-only ring on a transparent fill. Matches the
     glass vocabulary of the GL splash — the GL background bleeds
     through, the ring just hints at where the future circle will land. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="1.5dp"
        android:color="#660F70B0" />
    <solid android:color="@android:color/transparent" />
    <size
        android:width="@dimen/step_indicator_size"
        android:height="@dimen/step_indicator_size" />
</shape>

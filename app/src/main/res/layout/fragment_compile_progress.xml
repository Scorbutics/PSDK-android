<?xml version="1.0" encoding="utf-8"?>
<!--
    Intentionally empty: during compilation the splash (GL surface) IS the
    UI. CompileProgressFragment exists only to bootstrap the compile
    engine, route sub-step labels into loader.rb's status_text via
    <executionLocation>/.loader_status, and advance to CompileDoneFragment
    when the engine finishes. A thin slim progress bar at the top would
    just compete with the splash for attention — and the full per-step
    logs are surfaced from CompileDoneFragment ("View Logs") instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

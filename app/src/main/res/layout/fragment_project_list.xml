<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent root so the activity-owned GL splash shows behind. The
     "+" FAB lives centred on a halo View, occupying the slot where the
     GL splash used to render its game icon. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No projects yet"
                android:textAppearance="@style/TextAppearance.Psdk.Title"
                android:textColor="@color/colorOnSurfaceVariant"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a new project to get started"
                android:textAppearance="@style/TextAppearance.Psdk.Body"
                android:textColor="@color/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Project list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projectsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_md" />
    </FrameLayout>

    <!-- Centred "+" stack — halo on bottom (drawable, alpha-breathes via
         the fragment), FAB on top in splash-accent blue. The wrapping
         FrameLayout sits behind the recyclerview when there are projects
         and on top of the empty state when not; the FAB hides at
         MAX_PROJECTS so it can never overlap a row. -->
    <FrameLayout
        android:id="@+id/fabContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/newProjectHalo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_halo" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/newProjectFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Import archive"
            app:backgroundTint="@color/colorSplashAccent"
            app:tint="@color/colorOnSurface"
            app:fabCustomSize="88dp"
            app:maxImageSize="40dp"
            app:srcCompat="@android:drawable/ic_input_add" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

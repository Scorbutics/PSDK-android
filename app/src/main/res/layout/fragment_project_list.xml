<?xml version="1.0" encoding="utf-8"?>
<!-- Constellation layout: the centred "+" FAB is the gravity well; 1-3
     project "satellites" orbit it in a shallow arc above. No cards, no
     list chrome — each project is just a haloed icon + caption. The
     fragment positions the slots via translationX/Y and fades the unused
     ones out. Activity-owned GL splash shows behind everything. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Empty-state hint (shown only when 0 projects). -->
    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:translationY="120dp"
        android:text="Tap + to import a game"
        android:textAppearance="@style/TextAppearance.Psdk.Body"
        android:textColor="@color/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- 3 satellite slots. Initial translationX/Y are set programmatically
         in [arrangeSlots]; XML defaults are 0/0 so the slots render at
         centre on first measure (before the fragment arranges them) —
         alpha=0 keeps that frame invisible. -->
    <include layout="@layout/satellite_slot" android:id="@+id/satelliteSlot0" />
    <include layout="@layout/satellite_slot" android:id="@+id/satelliteSlot1" />
    <include layout="@layout/satellite_slot" android:id="@+id/satelliteSlot2" />

    <!-- Centred "+" stack. Halo on bottom, FAB on top. The fragment runs
         alpha-breath on the halo and scale-breath on the FAB; press
         releases spawn a particle burst (see [spawnFabParticles]). -->
    <FrameLayout
        android:id="@+id/fabContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/newProjectHalo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_halo" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/newProjectFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Import archive"
            app:backgroundTint="@color/colorSplashAccent"
            app:tint="@color/colorOnSurface"
            app:fabCustomSize="88dp"
            app:maxImageSize="40dp"
            app:srcCompat="@android:drawable/ic_input_add" />
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Glass-row card: semi-transparent fill so the GL starfield bleeds
     through, splash-accent stroke at low alpha. The adapter bumps the
     stroke alpha on press and runs an idle vertical bob on the root. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/projectCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/colorRowGlassFill"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:strokeColor="@color/colorRowGlassStroke"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/card_padding">

        <!-- Icon + halo. The halo is a separate View drawn behind so we
             don't have to pre-composite each project's accent into one
             drawable — pure layering. -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="@dimen/spacing_sm">

            <View
                android:id="@+id/projectIconHalo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_project_icon_halo" />

            <ImageView
                android:id="@+id/projectIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/projectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Psdk.Subtitle"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Status pill. Background tint and text color are set by the
                 adapter from the project's status (ready / needs-compile
                 / missing). -->
            <TextView
                android:id="@+id/projectStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_status_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textAppearance="@style/TextAppearance.Psdk.Caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sync warning (unreadable project). Delete moved to the wizard
             toolbar's overflow menu — see compile_wizard_menu.xml. -->
        <ImageView
            android:id="@+id/syncWarningIcon"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:src="@android:drawable/ic_dialog_alert"
            android:visibility="gone"
            app:tint="@color/colorWarning" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

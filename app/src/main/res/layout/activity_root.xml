<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity host for all in-app screens (hub, wizard, splash, and
     the game itself).

     Composition (back to front):
       [glSurface]         LiteRgssSurfaceView, fills the window; backs the
                           EGL context for both the splash and the game.
       [fragmentContainer] Hub / wizard fragments. Hidden by SystemUiPresenter
                           when the game workload is active.
       [imeSink]           1×1px transparent EditText used by ImeBridge to
                           capture soft-keyboard input when Ruby code asks
                           for the virtual keyboard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.psdk.ui.LiteRgssSurfaceView
        android:id="@+id/glSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Opaque mask over the SurfaceView during workload warm-up. SurfaceFlinger
         applies standard View alpha uniformly; applying alpha to the SurfaceView
         itself is non-uniform on some vendor compositors (the bottom band of
         the surface leaks through at alpha=0 until the next layout pass).
         Fading THIS view out instead of fading the SurfaceView in keeps the
         cross-fade clean everywhere. -->
    <View
        android:id="@+id/glSurfaceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground" />

    <!-- Game-start overlay: covers the GL surface from the moment the user
         taps "play" until Game.rb has constructed its DisplayWindow and the
         first frame is on screen. Holds a spinning project icon + caption
         so the screen never goes blank during the loader→game handoff (the
         loader's last frame would otherwise sit frozen for ~seconds while
         PSDK's require chain runs). Shown / hidden by [RootActivity]; the
         `[game-display-ready]` sentinel from start.rb is the cue. -->
    <FrameLayout
        android:id="@+id/gameStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/gameStartIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/logo"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/gameStartCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="Starting…"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <EditText
        android:id="@+id/imeSink"
        android:layout_width="1px"
        android:layout_height="1px"
        android:alpha="0"
        android:inputType="text"
        android:importantForAutofill="no"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</FrameLayout>

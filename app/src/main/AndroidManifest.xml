<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-feature android:glEsVersion="0x00010001" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="@string/app_name"
        android:icon="@drawable/logo"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Psdk">

        <!-- Entry point router -->
        <activity android:name=".ui.EntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Single in-app host (hub + wizard as fragments). -->
        <activity android:name=".ui.RootActivity"
            android:exported="false" />

        <!-- Game engine (single Activity, hosted SurfaceView + Ruby VM).
             Replaces android.app.NativeActivity: see com.psdk.ui.GameActivity
             for the hosted-input wiring. The "rgss_runtime" .so is loaded
             lazily by NativeSurface / PsdkInterpreter on first use, so no
             android.app.lib_name metadata is needed here. -->
        <activity android:name=".ui.GameActivity"
            android:theme="@style/Theme.Psdk"
            android:icon="@drawable/logo"
            android:screenOrientation="landscape"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

<provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.psdk.starter.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths">
            </meta-data>
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-feature android:glEsVersion="0x00010001" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- PSDK games go online (online features, mystery gifts, update checks); debug builds
         also need it for the rdbg/DAP listener and the remote-eval console (socket(2) → EPERM without it) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GameKeepAliveService: a game kept running in the background while it plays -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- GameDownloadService: a small APK's game downloaded at the first launch -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- A small APK asks before downloading its game on mobile data -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/logo"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Psdk">

        <!-- Entry point router. configChanges: a recreation while it reports
             a classic game's crash (GameExitReport) would lose that report. -->
        <activity android:name=".ui.EntryActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Single in-app host (hub + wizard as fragments).

             configChanges declared so the Activity survives rotation
             (and other config flips). Without this, every requestedOrientation
             change in SystemUiPresenter destroys + recreates the Activity,
             which destroys the persistent RubyWorkloadController interpreter
             mid-workload — the loader's render thread crashes with
             ClosedWindowError, then a fresh interpreter spins up on the new
             Activity and fails its first frame with libEGL "no current context".
             The SurfaceView's underlying surface still gets destroyed/recreated
             on real rotation; that's a more contained problem the render thread
             handles via SFML's surfaceCreated/surfaceDestroyed callbacks. -->
        <activity android:name=".ui.RootActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!-- The game, in its own process. CRuby can only be initialised once
             per process and PSDK's monkey-patching can't be undone, so each
             game session gets a fresh `:game` process, killed by
             GameActivity.onDestroy when the session ends. Same configChanges
             as RootActivity for the same reason: a recreation would land on
             an already-dirty VM. -->
        <activity android:name=".ui.GameActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!-- Keeps the app running while a small APK downloads its game
             (com.psdk.remote.GameDownloader), in the app's own process -->
        <service android:name=".remote.GameDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps the game's process running in the background while a game
             plays (its notification shows meanwhile): in the game's process,
             whose priority it raises. The player turns it off in the game's
             Settings. -->
        <service android:name=".ui.GameKeepAliveService"
            android:process=":game"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a game the player is playing running while they switch apps, so that the system does not end it and lose their progress." />
        </service>

<provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.psdk.starter.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths">
            </meta-data>
        </provider>
    </application>
</manifest>
